{
  "name": "mss-ai-gateway",
  "version": "1.1.0",
  "description": "الرحلة الكاملة 1→5 — AI Chat Gateway (Fastify/Postgres/Redis/S3) + Conversations/Auth + Smart Routing + Moderation + Code/Vibe Error Learning + Flutter",
  "type": "commonjs",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./router": "./src/router.js",
    "./features": "./src/features.js",
    "./classifier": "./src/classifier.js",
    "./store": "./src/store.js",
    "./cache": "./src/cache.js",
    "./gateway": "./src/gateway.js",
    "./server": "./src/server.js",
    "./moderation": "./src/moderation.js",
    "./logger": "./src/logger.js",
    "./phase1": "./src/phase1/routes/health.js",
    "./phase2": "./src/phase2/routes/conversations.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "migrate:psql": "for f in migrations/*.sql; do echo \"→ $f\"; psql $DATABASE_URL -f \"$f\"; done",
    "migrate:memory": "echo 'memory fallback — no DB to migrate'",
    "wait:db": "node scripts/wait-for-db.js",
    "test": "node --test tests/**/*.test.js",
    "test:verbose": "node --test --test-reporter=spec tests/**/*.test.js",
    "benchmark": "node scripts/benchmark.js",
    "example": "node examples/gateway-example.js",
    "example:phase1": "node examples/phase1-phase2.js",
    "example:full": "node examples/full-journey.js",
    "lint": "node --check src/**/*.js",
    "docker:build": "docker build -t mss-ai-gateway:1.1.0 .",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f gateway",
    "docker:down": "docker compose down"
  },
  "keywords": ["ai-gateway", "fastify", "postgres", "redis", "s3", "smart-routing", "flutter", "jwt", "moderation"],
  "license": "MIT",
  "engines": { "node": ">=18" }
}
