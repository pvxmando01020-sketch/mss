# --- API Gateway ---
PORT=4000
# Real models only appear when keys are set. Without keys, demo (mock) models run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Rate limits per session
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=2000
# true = hard-block requests matching prompt-injection patterns
MODERATION_STRICT=false
LOG_LEVEL=info

# --- Phase 2: data layer (leave empty to run the in-memory fallback) ---
DATABASE_URL=postgres://mss:mss@localhost:5432/mss
REDIS_URL=redis://localhost:6379
# S3-compatible storage (MinIO locally via docker compose, any S3 provider in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=mss
S3_SECRET_KEY=mss12345
S3_BUCKET=mss

# --- Web ---
MSS_API_URL=http://127.0.0.1:4000
